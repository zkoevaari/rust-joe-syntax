# JOE syntax highlight file for Rust

=Idle
#~ =Comment		green
=Comment		dim
=Number			cyan
=Boolean		cyan
#~ =String			cyan
=String			magenta
#~ =StringEscape           bold cyan
=StringEscape           bold magenta
#~ =Character		cyan
=Character		magenta
=CharacterEscape

#~ =Lifetime	yellow
=Lifetime	cyan
#~ =Attribute	blue
=Attribute	yellow
#~ =Macro		blue
=Macro		yellow
#~ =Suffix		blue
=Suffix		yellow

#~ =Keyword        bold
=Keyword        bold blue
#~ =Operator	bold
=Operator	bold blue
#~ =Statement	bold
=Statement	bold blue
#~ =Conditional	bold
=Conditional	bold blue
#~ =Loop		bold
=Loop		bold blue
#~ =Qualifyer	bold
=Qualifyer	bold blue
#~ =Structure	bold
=Structure	bold blue
#~ =Type		bold
=Type		bold blue
=Deprecated

=Bad	        bold red
#~ =Brace		magenta
=Brace
=Control
=QuestionMark	red


:pre_idle Idle
	*		NULL		noeat call=.rust()

.subr rust

:idle Idle
	*		idle
	"{}"		brace		recolor=-1
	"0"		zero		recolor=-1
	"1-9"		decimal		recolor=-1
	"\""		string		recolor=-1
	"'"		single_quote	recolor=-1
	"/"		slash		recolor=-1
	"#"		hash		recolor=-1
	"?"		question	recolor=-1
	"a-zA-Z_"	ident		mark buffer
	".,:;=()><[]*&|!~+\-%^"	control	recolor=-1

:slash Idle
	*		idle		noeat
	"*"		comment		recolor=-2
	"/"		line_comment	recolor=-2

:brace Brace
	*		idle		noeat

:control Control
	*		idle		noeat

:question QuestionMark
	*		idle		noeat

:comment Comment
	*		comment
	"*"		maybe_end_comment

:maybe_end_comment Comment
	*		comment		noeat
	"/"		idle

:line_comment Comment
	*		line_comment
	"\n"		idle


# Numbers

:zero Number
	*		suffix	noeat
	"b"		maybe_binary    mark recolor=-1
	"o"		maybe_octal     mark recolor=-1
	"x"		maybe_hex       mark recolor=-1
	"0-9_"		decimal	recolor=-1
	"."		maybe_float
	"eE"		maybe_exp       mark recolor=-1
	"ui"		int_suffix	noeat mark buffer
	"f"		float_suffix    noeat mark buffer

:maybe_binary Bad
	*		idle	noeat
	"_"		maybe_binary
	"01"		binary  noeat recolormark
	"2-9a-zA-Z"	bad_number

:binary Number
	*		suffix	noeat
	"01_"		binary
	"ui"		int_suffix	noeat mark buffer
        "2-9eE"   	bad_number      recolor=-1
        "."             maybe_bad_number        recolor=-1

:maybe_octal Bad
	*		idle	noeat
	"_"		maybe_octal
	"0-7"		octal   noeat recolormark
	"89a-zA-Z"	bad_number

:octal Number
	*		suffix	noeat
	"0-7_"		octal
	"ui"		int_suffix	noeat mark buffer
        "89eE"       	bad_number      recolor=-1
        "."             maybe_bad_number        recolor=-1

:maybe_hex Bad
	*		idle	noeat
	"_"     	maybe_hex
	"0-9A-Fa-f"	hex     noeat recolormark
	"g-zG-Z"	bad_number

:hex Number
	*		suffix	noeat
	"0-9A-Fa-f_"	hex
	"ui"		int_suffix	noeat mark buffer
        "."             maybe_bad_number        recolor=-1

:decimal Number
	*		suffix	noeat
	"0-9_"		decimal
	"."		maybe_float
	"eE"		maybe_exp       mark recolor=-1
	"ui"		int_suffix	noeat mark buffer
	"f"		float_suffix	noeat mark buffer

:int_suffix Suffix
	*		suffix	noeat markend strings
	"i8"		valid_number_suffix
	"i16"		valid_number_suffix
	"i32"		valid_number_suffix
	"i64"		valid_number_suffix
	"i128"		valid_number_suffix
	"isize"		valid_number_suffix
	"u8"		valid_number_suffix
	"u16"		valid_number_suffix
	"u32"		valid_number_suffix
	"u64"		valid_number_suffix
	"u128"		valid_number_suffix
	"usize"		valid_number_suffix
done
	"iusze0-9"	int_suffix

:maybe_float Number
	*		idle	noeat recolor=-2
	"0-9"		float

:float Number
	*		suffix	noeat
	"0-9_"		float
	"eE"		maybe_exp       mark recolor=-1
	"f"		float_suffix	noeat mark buffer

:maybe_exp Bad
	*		bad_number	noeat
	"_+\-"   	exp_sign
        "0-9"           exp     noeat recolormark

:exp_sign Bad
        *               bad_number    noeat
        "_"        	exp_sign
        "0-9"           exp     noeat recolormark

:exp Number
	*		suffix	noeat
	"0-9_"		exp
	"f"		float_suffix	noeat mark buffer

:float_suffix Suffix
	*		suffix	noeat markend strings
	"f16"		valid_number_suffix
	"f32"		valid_number_suffix
	"f64"		valid_number_suffix
	"f128"		valid_number_suffix
done
	"f0-9"   	float_suffix

:valid_number_suffix Number
	*		idle	noeat
	"a-zA-z0-9_"	suffix        noeat recolormark

:suffix Suffix
        *		idle	noeat
	"a-zA-z0-9_"	suffix

:maybe_bad_number Bad
	*		idle	noeat
	"a-zA-Z_"	idle	noeat recolor=-2
	"0-9"	        bad_number

:bad_number Bad
	*		idle	noeat
	"a-zA-z0-9_"	bad_number


# Character constants, lifetimes and loop_labels:

:single_quote Lifetime
	*		char            recolor=-2
	"a-zA-Z_"	maybe_lifetime
	"'"		idle		recolormark

:maybe_lifetime Lifetime
	*		idle		noeat
	"'"		char_done	recolor=-3
	"0-9a-zA-Z_"	maybe_lifetime

:char Character
	*		idle		noeat recolor=-3
	"'"		char_done

:char_done Character
	*		idle		noeat


# Character escapes
# Strings
# Raw strings
# Byte strings
# Raw byte strings


# Identifiers (Edition 2024)

:ident Idle
	*		idle	noeat markend strings

	# Strict keywords
	"as"		operator
	"async"		quali
	"await"		stmt
	"break"		loop
	"const"		quali
	"continue"	loop
	"crate"		kw
	"dyn"		kw
	"else"		cond
	"enum"		struct
	"extern"	quali
	"false"		bool
	"fn"		struct
	"for"		loop
	"if"		cond
	"impl"		kw
	"in"		operator
	"let"		kw
	"loop"		loop
	"match"		kw
	"mod"		kw
	"move"		kw
	"mut"		kw
	"pub"		quali
	"ref"		kw
	"return"	stmt
	"self"		kw
	"Self"		kw
	"static"	quali
	"struct"	struct
	"super"		kw
	"trait"		kw
	"true"		bool
	"type"		kw
	"unsafe"	quali
	"use"		kw
	"where"		kw
	"while"		loop

	# Weak keywords
	"macro_rules"	kw
	"raw"		kw
	"safe"		quali
	"union"		struct

	# Reserved keywords
	"abstract"	quali
	"become"	kw
	"box"		kw
	"do"		loop
	"final"		quali
	"gen"		kw
	"macro"		kw
	"override"	quali
	"priv"		quali
	"try"		kw
	"typeof"	kw
	"unsized"	quali
	"virtual"	quali
	"yield"		stmt

	# Built-in types
	"bool"		type
	"char"		type
	"f16"		type
	"f32"		type
	"f64"		type
	"f128"		type
	"i8"		type
	"i16"		type
	"i32"		type
	"i64"		type
	"i128"		type
	"isize"		type
	"str"		type
	"u8"		type
	"u16"		type
	"u32"		type
	"u64"		type
	"u128"		type
	"usize"		type

	# Deprecated (i.e. may be used as ident.)
	"alignof"	depr
	"be"		depr
	"int"		depr
	"offsetof"	depr
	"once"		depr
	"proc"		depr
	"pure"		depr
	"sizeof"	depr
	"uint"		depr

	# Prefixes
	"r"		raw_prefix
	"b"		byte_prefix
	"br"		raw_byte_prefix
done
	"a-zA-Z0-9_"	ident
	"!"		macro		noeat recolormark

:kw Keyword
	*		idle		noeat

:bool Boolean
	*		idle		noeat

:operator Operator
	*		idle		noeat

:stmt Statement
	*		idle		noeat

:cond Conditional
	*		idle		noeat

:loop Loop
	*		idle		noeat

:quali Qualifyer
	*		idle		noeat

:struct Structure
	*		idle		noeat

:type Type
	*		idle		noeat

:depr Deprecated
	*		idle		noeat


# Macro invocations

:macro Macro
	*		idle


# Attributes

:hash Attribute
	*		idle		noeat recolor=-2
	"["		attr
	"!"		maybe_inner

:maybe_inner Attribute
	*		idle		noeat recolor=-3
	"["		attr

:attr Attribute
	*		attr
	"]"		idle


.end

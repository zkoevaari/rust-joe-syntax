# JOE syntax highlight file for Rust

=Idle
#~ =Comment		green
=Comment		dim
=Number			cyan
=Boolean		cyan
#~ =String			cyan
=String			magenta
#~ =StringEscape		bold cyan
=StringEscape		bold magenta
#~ =Character		cyan
=Character		magenta
=CharacterEscape	bold magenta

#~ =Lifetime	yellow
=Lifetime	cyan
#~ =Attribute	blue
=Attribute	yellow
#~ =Macro		blue
=Macro		yellow
#~ =Suffix		blue
=Suffix		yellow

#~ =Keyword	bold
=Keyword	bold blue
#~ =Operator	bold
=Operator	bold blue
#~ =Statement	bold
=Statement	bold blue
#~ =Conditional	bold
=Conditional	bold blue
#~ =Loop		bold
=Loop		bold blue
#~ =Qualifier	bold
=Qualifier	bold blue
#~ =Structure	bold
=Structure	bold blue
#~ =Type		bold
=Type		bold blue
=Deprecated

=Bad		bold red
#~ =Brace		magenta
=Brace
=Control
=QuestionMark	red


:pre_idle Idle
	*		NULL		noeat call=.rust()

.subr rust

:idle Idle
	*		idle
	"0"		zero		recolor=-1
	"1-9"		decimal		recolor=-1
	"a-zA-Z_"	ident		mark buffer
	"'"		maybe_char	mark recolor=-1
	"\""		string		recolor=-1
	"/"		slash		recolor=-1
	"#"		hash		recolor=-1
	"?"		question	recolor=-1
	"{}"		brace		recolor=-1
	".,:;=()><[]*&|!~+%^\-"	control	recolor=-1

:slash Idle
	*		idle		noeat
	"*"		comment		recolor=-2
	"/"		line_comment	recolor=-2

:brace Brace
	*		idle		noeat

:control Control
	*		idle		noeat

:question QuestionMark
	*		idle		noeat

:comment Comment
	*		comment
	"*"		maybe_end_comment

:maybe_end_comment Comment
	*		comment		noeat
	"/"		idle

:line_comment Comment
	*		line_comment
	"\n"		idle


# Numbers

:zero Number
	*		suffix	noeat
	"b"		maybe_binary	mark recolor=-1
	"o"		maybe_octal	mark recolor=-1
	"x"		maybe_hex	mark recolor=-1
	"0-9_"		decimal
	"."		maybe_float	recolor=-1
	"eE"		maybe_exp	mark recolor=-1
	"ui"		int_suffix	noeat mark buffer
	"f"		float_suffix	noeat mark buffer

:maybe_binary Bad
	*		idle		noeat
	"_"		maybe_binary
	"01"		binary		noeat recolormark
	"2-9a-zA-Z"	bad_number

:binary Number
	*		suffix		noeat
	"01_"		binary
	"ui"		int_suffix	noeat mark buffer
	"2-9eE"		bad_number	recolor=-1
	"."		maybe_bad	recolor=-1

:maybe_octal Bad
	*		idle		noeat
	"_"		maybe_octal
	"0-7"		octal		noeat recolormark
	"89a-zA-Z"	bad_number

:octal Number
	*		suffix		noeat
	"0-7_"		octal
	"ui"		int_suffix	noeat mark buffer
	"89eE"		bad_number	recolor=-1
	"."		maybe_bad	recolor=-1

:maybe_hex Bad
	*		idle		noeat
	"_"		maybe_hex
	"0-9A-Fa-f"	hex		noeat recolormark
	"g-zG-Z"	bad_number

:hex Number
	*		suffix		noeat
	"0-9A-Fa-f_"	hex
	"ui"		int_suffix	noeat mark buffer
	"."		maybe_bad	recolor=-1

:decimal Number
	*		suffix		noeat
	"0-9_"		decimal
	"."		maybe_float	recolor=-1
	"eE"		maybe_exp	mark recolor=-1
	"ui"		int_suffix	noeat mark buffer
	"f"		float_suffix	noeat mark buffer

:int_suffix Suffix
	*		suffix		noeat markend strings
	"i8"		valid_number_suffix
	"i16"		valid_number_suffix
	"i32"		valid_number_suffix
	"i64"		valid_number_suffix
	"i128"		valid_number_suffix
	"isize"		valid_number_suffix
	"u8"		valid_number_suffix
	"u16"		valid_number_suffix
	"u32"		valid_number_suffix
	"u64"		valid_number_suffix
	"u128"		valid_number_suffix
	"usize"		valid_number_suffix
done
	"iusze0-9"	int_suffix

:maybe_bad Control
	*		bad_number	noeat recolor=-2
	"._a-zA-Z"	idle		noeat

:maybe_float Control
	*		idle		noeat
	"0-9\ \r\n"	float		noeat recolor=-2

:float Number
	*		suffix		noeat
	"0-9_"		float
	"eE"		maybe_exp	mark recolor=-1
	"f"		float_suffix	noeat mark buffer

:maybe_exp Bad
	*		bad_number	noeat
	"_+\-"		exp_sign
	"0-9"		exp		noeat recolormark

:exp_sign Bad
	*		bad_number	noeat
	"_"		exp_sign
	"0-9"		exp		noeat recolormark

:exp Number
	*		suffix		noeat
	"0-9_"		exp
	"f"		float_suffix	noeat mark buffer

:float_suffix Suffix
	*		suffix		noeat markend strings
	"f16"		valid_number_suffix
	"f32"		valid_number_suffix
	"f64"		valid_number_suffix
	"f128"		valid_number_suffix
done
	"f0-9"		float_suffix

:valid_number_suffix Number
	*		idle		noeat
	"a-zA-Z0-9_"	suffix		noeat recolormark

:suffix Suffix
	*		idle		noeat
	"a-zA-Z0-9_"	suffix

:bad_number Bad
	*		idle		noeat
	"a-zA-Z0-9_"	bad_number


# Characters, lifetimes and loop_labels:

:maybe_char Character
	*		char_end
	"\\"		maybe_char_esc	recolor=-1
	"'\n\r\t"	bad_char	noeat recolormark
	"a-zA-Z_"	maybe_lifetime

:maybe_lifetime Lifetime
	*		lifetime	noeat recolormark
	"'"		char_done	recolor=-1
	"0-9a-zA-Z_"	lifetime	recolormark

:lifetime Lifetime
	*		idle		noeat
	"'"		bad_char_end	recolormark
	"0-9a-zA-Z_"	lifetime

:maybe_char_esc CharacterEscape
	*		bad_char	recolor=-3
	"0nrt'\"\\"	char_end
	"u"		maybe_char_uni
	"x"		char_hex1

:char_hex1 CharacterEscape
	*		bad_char	noeat recolormark
	"0-7"		char_hex2

:char_hex2 CharacterEscape
	*		bad_char	noeat recolormark
	"0-9a-fA-F"	char_end

:maybe_char_uni CharacterEscape
	*		bad_char	noeat recolormark
	"{"		char_uni_start

:char_uni_start CharacterEscape
	*		bad_char	noeat recolormark
	"0-9a-fA-F"	char_uni

:char_uni CharacterEscape
	*		bad_char	noeat recolormark
	"0-9a-fA-F_"	char_uni
	"}"		char_end

:char_end Character
	*		bad_char	noeat recolormark
	"'"		char_done

:char_done Character
	*		suffix		noeat

:bad_char Bad
	*		bad_char
	"'\n"		bad_char_end

:bad_char_end Bad
	*		idle		noeat


# Byte literals

:byte_prefix Ident
	*		idle		noeat recolor=-1
	"'"		byte		recolor=-2
	"\""		byte_str	recolor=-2

:byte Character
	*		char_end
	"\\"		maybe_byte_esc	recolor=-1
	"'\n\r\t"	bad_char	noeat recolormark

:maybe_byte_esc CharacterEscape
	*		bad_char	noeat recolormark
	"0nrt'\"\\"	char_end
	"x"		byte_hex1

:byte_hex1 CharacterEscape
	*		bad_char	noeat recolormark
	"0-9a-fA-F"	byte_hex2

:byte_hex2 CharacterEscape
	*		bad_char	noeat recolormark
	"0-9a-fA-F"	char_end


# Strings

:string String
	*		string
	"\\"		str_esc		mark recolor=-1
	"\""		suffix

:str_esc StringEscape
	*		str_bad_esc	noeat recolormark
	"0nrt'\"\n\\"	string
	"u"		maybe_str_uni
	"x"		str_hex1

:str_hex1 StringEscape
	*		str_bad_esc	noeat recolormark
	"0-7"		str_hex2

:str_hex2 StringEscape
	*		str_bad_esc	noeat recolormark
	"0-9a-fA-F"	string

:maybe_str_uni StringEscape
	*		str_bad_esc	noeat recolormark
	"{"		str_uni_start

:str_uni_start StringEscape
	*		str_bad_esc	noeat recolormark
	"0-9a-fA-F"	str_uni

:str_uni StringEscape
	*		str_bad_esc	noeat recolormark
	"0-9a-fA-F_"	str_uni
	"}"		string

:str_bad_esc Bad
	*		string


# Byte strings

:byte_str String
	*		byte_str
	"\\"		bstr_esc	mark recolor=-1
	"\""		suffix

:bstr_esc StringEscape
	*		bstr_bad_esc	noeat recolormark
	"0nrt'\"\n\\"	byte_str
	"x"		bstr_hex1

:bstr_hex1 StringEscape
	*		bstr_bad_esc	noeat recolormark
	"0-9a-fA-F"	bstr_hex2

:bstr_hex2 StringEscape
	*		bstr_bad_esc	noeat recolormark
	"0-9a-fA-F"	byte_str

:bstr_bad_esc Bad
	*		byte_str


# C strings

:cstr_prefix Ident
	*		idle		noeat recolor=-1
	"\""		c_string	recolor=-2

:c_string String
	*		c_string
	"\\"		cstr_esc	mark recolor=-1
	"\""		suffix

:cstr_esc StringEscape
	*		cstr_bad_esc	noeat recolormark
	"nrt'\"\n\\"	c_string
	"u"		maybe_cstr_uni
	"x"		cstr_hex1

:cstr_hex1 StringEscape
	*		cstr_bad_esc	noeat recolormark
	"0"		cstr_hex2_0
	"1-7"		cstr_hex2

:cstr_hex2_0 StringEscape
	*		cstr_bad_esc	noeat recolormark
	"1-9a-fA-F"	c_string

:cstr_hex2 StringEscape
	*		cstr_bad_esc	noeat recolormark
	"0-9a-fA-F"	c_string

:maybe_cstr_uni StringEscape
	*		cstr_bad_esc	noeat recolormark
	"{"		cstr_uni_start

:cstr_uni_start StringEscape
	*		cstr_bad_esc	noeat recolormark
	"0"		cstr_uni_0
	"1-9a-fA-F"	cstr_uni

:cstr_uni_0 StringEscape
	*		cstr_bad_esc	noeat recolormark
	"0_"		cstr_uni_0
	"1-9a-fA-F"	cstr_uni

:cstr_uni StringEscape
	*		cstr_bad_esc	noeat recolormark
	"0-9a-fA-F_"	cstr_uni
	"}"		c_string

:cstr_bad_esc Bad
	*		c_string


# Raw strings
# Raw byte strings


# Identifiers (Edition 2024)

:ident Idle
	*		idle		noeat markend strings

	# Strict keywords
	"as"		operator
	"async"		quali
	"await"		stmt
	"break"		loop
	"const"		quali
	"continue"	loop
	"crate"		kw
	"dyn"		kw
	"else"		cond
	"enum"		struct
	"extern"	quali
	"false"		bool
	"fn"		struct
	"for"		loop
	"if"		cond
	"impl"		kw
	"in"		operator
	"let"		kw
	"loop"		loop
	"match"		kw
	"mod"		kw
	"move"		kw
	"mut"		kw
	"pub"		quali
	"ref"		kw
	"return"	stmt
	"self"		kw
	"Self"		kw
	"static"	quali
	"struct"	struct
	"super"		kw
	"trait"		kw
	"true"		bool
	"type"		kw
	"unsafe"	quali
	"use"		kw
	"where"		kw
	"while"		loop

	# Weak keywords
	"macro_rules"	kw
	"raw"		kw
	"safe"		quali
	"union"		struct

	# Reserved keywords
	"abstract"	quali
	"become"	kw
	"box"		kw
	"do"		loop
	"final"		quali
	"gen"		kw
	"macro"		kw
	"override"	quali
	"priv"		quali
	"try"		kw
	"typeof"	kw
	"unsized"	quali
	"virtual"	quali
	"yield"		stmt

	# Built-in types
	"bool"		type
	"char"		type
	"f16"		type
	"f32"		type
	"f64"		type
	"f128"		type
	"i8"		type
	"i16"		type
	"i32"		type
	"i64"		type
	"i128"		type
	"isize"		type
	"str"		type
	"u8"		type
	"u16"		type
	"u32"		type
	"u64"		type
	"u128"		type
	"usize"		type

	# Deprecated (i.e. may be used as ident.)
	"alignof"	depr
	"be"		depr
	"int"		depr
	"offsetof"	depr
	"once"		depr
	"proc"		depr
	"pure"		depr
	"sizeof"	depr
	"uint"		depr

	# Prefixes
	"b"		byte_prefix
	"c"		cstr_prefix
	#~ "r"		raw_prefix
	#~ "br"		raw_byte_prefix
done
	"a-zA-Z0-9_"	ident
	"!"		macro		noeat recolormark

:kw Keyword
	*		idle		noeat

:bool Boolean
	*		idle		noeat

:operator Operator
	*		idle		noeat

:stmt Statement
	*		idle		noeat

:cond Conditional
	*		idle		noeat

:loop Loop
	*		idle		noeat

:quali Qualifier
	*		idle		noeat

:struct Structure
	*		idle		noeat

:type Type
	*		idle		noeat

:depr Deprecated
	*		idle		noeat


# Macro invocations

:macro Macro
	*		idle


# Attributes

:hash Attribute
	*		idle		noeat recolor=-2
	"["		attr
	"!"		maybe_inner

:maybe_inner Attribute
	*		idle		noeat recolor=-3
	"["		attr

:attr Attribute
	*		attr
	"]"		idle


.end

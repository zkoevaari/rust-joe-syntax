# JOE syntax highlight file for Rust

=Idle

=Comment		green
#~ =Comment		dim
=DocComment		green
#~ =DocComment		dim yellow
=DocCommentDelim	bold green
#~ =DocCommentDelim	dim bold yellow

=Number			cyan
=Boolean		cyan
=String			cyan
#~ =String			magenta
=StringEscape		bold cyan
#~ =StringEscape		bold magenta
=Character		cyan
#~ =Character		magenta
=CharacterEscape	bold cyan
#~ =CharacterEscape	bold magenta

=Lifetime	yellow
#~ =Lifetime	cyan
=Attribute	blue
#~ =Attribute	yellow
=HashMark	blue
#~ =HashMark	yellow
=Macro		blue
#~ =Macro		yellow
=DollarSign	blue
#~ =DollarSign	yellow
=Suffix		blue
#~ =Suffix		yellow

=Keyword	bold
#~ =Keyword	bold blue
=Operator	bold
#~ =Operator	bold blue
=Statement	bold
#~ =Statement	bold blue
=Conditional	bold
#~ =Conditional	bold blue
=Loop		bold
#~ =Loop		bold blue
=Qualifier	bold
#~ =Qualifier	bold blue
=Structure	bold
#~ =Structure	bold blue
=Type		bold
#~ =Type		bold blue
=SpecialTrait	bold blue
#~ =SpecialTrait	green
=Deprecated

=Bad		bold red
=Brace		magenta
#~ =Brace
=Control
=ExclamationMark	bold dim red
=QuestionMark		bold dim red


:pre_idle Idle
	*		NULL		noeat call=.rust()

.subr rust

:idle Idle
	*		idle
	"0"		zero		recolor=-1
	"1-9"		decimal		recolor=-1
	"a-zA-Z_"	ident		mark buffer
	"'"		maybe_char	mark recolor=-1
	"\""		string		recolor=-1
	"/"		slash		mark
	"#"		hash		recolor=-1
	"!"		bang		recolor=-1
	"?"		question	recolor=-1
	"$"		dollar		recolor=-1
	"{}"		brace		recolor=-1
	".,:;=()><[]*&|~+%^\-"	control	recolor=-1

:brace Brace
	*		idle		noeat

:control Control
	*		idle		noeat

:bang ExclamationMark
	*		idle		noeat
	"="		control		recolor=-2

:question QuestionMark
	*		idle		noeat

:dollar DollarSign
	*		idle		noeat


# Comments

:slash Idle
	*		idle			noeat
	"/"		line_comment_start	recolor=-2
	"*"		block_comment_start	recolor=-2

:line_comment_start Comment
	*		line_comment	noeat markend
	"/"		maybe_line_doc	recolor=-3
	"!"		line_doc_start	recolor=-3

:line_comment Comment
	*		line_comment
	"BFHNTX"	line_comment	noeat call=comment_todo.comment_todo()
	"\n"		idle

:maybe_line_doc DocCommentDelim
	*		line_doc	noeat markend
	"/"		line_comment	noeat recolormark

:line_doc_start DocCommentDelim
	*		line_doc	noeat markend

:line_doc DocComment
	*		line_doc
	"BFHNTX"	line_doc	noeat call=comment_todo.comment_todo()
	"\n"		idle

:block_comment_start Comment
	*		block_comment		noeat markend
	"*"		maybe_block_outer	recolor=-3
	"!"		block_doc_start		recolor=-3

:block_comment Comment
	*		block_comment
	"BFHNTX"	block_comment	noeat call=comment_todo.comment_todo()
	"*"		maybe_end_comment
	"/"		maybe_nest_comment

:maybe_end_comment Comment
	*		block_comment	noeat
	"/"		idle

:maybe_nest_comment Comment
	*		block_comment	noeat
	"*"		block_comment2

:block_comment2 Comment
	*		block_comment2
	"BFHNTX"	block_comment2	noeat call=comment_todo.comment_todo()
	"*"		maybe_end_comment2
	"/"		maybe_nest_comment2

:maybe_end_comment2 Comment
	*		block_comment2	noeat
	"/"		block_comment

:maybe_nest_comment2 Comment
	*		block_comment2	noeat
	"*"		block_comment3

:block_comment3 Comment
	*		block_comment3
	"BFHNTX"	block_comment3	noeat call=comment_todo.comment_todo()
	"*"		maybe_end_comment3
	"/"		maybe_nest_comment3

:maybe_end_comment3 Comment
	*		block_comment3	noeat
	"/"		block_comment2

:maybe_nest_comment3 Comment
	*		block_comment3	noeat
	"*"		block_comment4

:block_comment4 Comment
	*		block_comment4
	"BFHNTX"	block_comment4	noeat call=comment_todo.comment_todo()
	"*"		maybe_end_comment4

:maybe_end_comment4 Comment
	*		block_comment4	noeat
	"/"		block_comment3

:maybe_block_outer DocCommentDelim
	*		block_doc		noeat markend
	"*/"		maybe_end_comment	noeat recolormark

:block_doc_start DocCommentDelim
	*		block_doc	noeat

:block_doc DocComment
	*		block_doc
	"BFHNTX"	block_doc	noeat call=comment_todo.comment_todo()
	"*"		maybe_end_doc	recolor=-1
	"/"		maybe_nest_doc

:maybe_end_doc DocCommentDelim
	*		block_doc	noeat recolor=-2
	"/"		idle

:maybe_nest_doc DocComment
	*		block_doc	noeat
	"*"		block_doc2

:block_doc2 DocComment
	*		block_doc2
	"BFHNTX"	block_doc2	noeat call=comment_todo.comment_todo()
	"*"		maybe_end_doc2
	"/"		maybe_nest_doc2

:maybe_end_doc2 DocComment
	*		block_doc2	noeat
	"/"		block_doc

:maybe_nest_doc2 DocComment
	*		block_doc2	noeat
	"*"		block_doc3

:block_doc3 DocComment
	*		block_doc3
	"BFHNTX"	block_doc3	noeat call=comment_todo.comment_todo()
	"*"		maybe_end_doc3
	"/"		maybe_nest_doc3

:maybe_end_doc3 DocComment
	*		block_doc3	noeat
	"/"		block_doc2

:maybe_nest_doc3 DocComment
	*		block_doc3	noeat
	"*"		block_doc4

:block_doc4 DocComment
	*		block_doc4
	"BFHNTX"	block_doc4	noeat call=comment_todo.comment_todo()
	"*"		maybe_end_doc4

:maybe_end_doc4 DocComment
	*		block_doc4	noeat
	"/"		block_doc3

# Numbers

:zero Number
	*		suffix	noeat
	"b"		maybe_binary	mark recolor=-1
	"o"		maybe_octal	mark recolor=-1
	"x"		maybe_hex	mark recolor=-1
	"0-9_"		decimal
	"."		maybe_float	recolor=-1
	"eE"		maybe_exp	mark recolor=-1
	"ui"		int_suffix	noeat mark buffer
	"f"		float_suffix	noeat mark buffer

:maybe_binary Bad
	*		idle		noeat
	"_"		maybe_binary
	"01"		binary		noeat recolormark
	"2-9a-zA-Z"	bad_number

:binary Number
	*		suffix		noeat
	"01_"		binary
	"ui"		int_suffix	noeat mark buffer
	"2-9eE"		bad_number	recolor=-1
	"."		maybe_bad	recolor=-1

:maybe_octal Bad
	*		idle		noeat
	"_"		maybe_octal
	"0-7"		octal		noeat recolormark
	"89a-zA-Z"	bad_number

:octal Number
	*		suffix		noeat
	"0-7_"		octal
	"ui"		int_suffix	noeat mark buffer
	"89eE"		bad_number	recolor=-1
	"."		maybe_bad	recolor=-1

:maybe_hex Bad
	*		idle		noeat
	"_"		maybe_hex
	"0-9A-Fa-f"	hex		noeat recolormark
	"g-zG-Z"	bad_number

:hex Number
	*		suffix		noeat
	"0-9A-Fa-f_"	hex
	"ui"		int_suffix	noeat mark buffer
	"."		maybe_bad	recolor=-1

:decimal Number
	*		suffix		noeat
	"0-9_"		decimal
	"."		maybe_float	recolor=-1
	"eE"		maybe_exp	mark recolor=-1
	"ui"		int_suffix	noeat mark buffer
	"f"		float_suffix	noeat mark buffer

:int_suffix Suffix
	*		suffix		noeat markend strings
	"i8"		valid_number_suffix
	"i16"		valid_number_suffix
	"i32"		valid_number_suffix
	"i64"		valid_number_suffix
	"i128"		valid_number_suffix
	"isize"		valid_number_suffix
	"u8"		valid_number_suffix
	"u16"		valid_number_suffix
	"u32"		valid_number_suffix
	"u64"		valid_number_suffix
	"u128"		valid_number_suffix
	"usize"		valid_number_suffix
done
	"iusze0-9"	int_suffix

:maybe_bad Control
	*		bad_number	noeat recolor=-2
	"._a-zA-Z"	idle		noeat

:maybe_float Control
	*		idle		noeat
	"0-9\ \r\n"	float		noeat recolor=-2

:float Number
	*		suffix		noeat
	"0-9_"		float
	"eE"		maybe_exp	mark recolor=-1
	"f"		float_suffix	noeat mark buffer

:maybe_exp Bad
	*		bad_number	noeat
	"_+\-"		exp_sign
	"0-9"		exp		noeat recolormark

:exp_sign Bad
	*		bad_number	noeat
	"_"		exp_sign
	"0-9"		exp		noeat recolormark

:exp Number
	*		suffix		noeat
	"0-9_"		exp
	"f"		float_suffix	noeat mark buffer

:float_suffix Suffix
	*		suffix		noeat markend strings
	"f16"		valid_number_suffix
	"f32"		valid_number_suffix
	"f64"		valid_number_suffix
	"f128"		valid_number_suffix
done
	"f0-9"		float_suffix

:valid_number_suffix Number
	*		idle		noeat
	"a-zA-Z0-9_"	suffix		noeat recolormark

:suffix Suffix
	*		idle		noeat
	"a-zA-Z0-9_"	suffix

:bad_number Bad
	*		idle		noeat
	"a-zA-Z0-9_"	bad_number


# Characters, lifetimes and loop_labels:

:maybe_char Character
	*		char_end
	"\\"		maybe_char_esc	recolor=-1
	"'\n\r\t"	bad_char	noeat recolormark
	"r"		maybe_raw_lt
	"a-qs-zA-Z_"	maybe_lt

:maybe_lt Lifetime
	*		lifetime	noeat recolormark
	"'"		char_done	recolor=-1
	"#"		bad_char_end	recolormark recolor=-1
	"0-9a-zA-Z_"	lifetime	recolormark

:maybe_raw_lt Lifetime
	*		lifetime	noeat recolormark
	"'"		char_done	recolor=-1
	"0-9a-zA-Z_#"	lifetime	recolormark

:lifetime Lifetime
	*		idle		noeat
	"'#"		bad_char_end	recolormark recolor=-1
	"0-9a-zA-Z_"	lifetime

:maybe_char_esc CharacterEscape
	*		bad_char	recolor=-3
	"0nrt'\"\\"	char_end
	"u"		maybe_char_uni
	"x"		char_hex1

:char_hex1 CharacterEscape
	*		bad_char	noeat recolormark
	"0-7"		char_hex2

:char_hex2 CharacterEscape
	*		bad_char	noeat recolormark
	"0-9a-fA-F"	char_end

:maybe_char_uni CharacterEscape
	*		bad_char	noeat recolormark
	"{"		char_uni_start

:char_uni_start CharacterEscape
	*		bad_char	noeat recolormark
	"0-9a-fA-F"	char_uni

:char_uni CharacterEscape
	*		bad_char	noeat recolormark
	"0-9a-fA-F_"	char_uni
	"}"		char_end

:char_end Character
	*		bad_char	noeat recolormark
	"'"		char_done

:char_done Character
	*		suffix		noeat

:bad_char Bad
	*		bad_char
	"'\n"		bad_char_end

:bad_char_end Bad
	*		idle		noeat


# Byte literals

:byte_prefix Idle
	*		idle		noeat
	"'"		byte		recolor=-2
	"\""		byte_str	recolor=-2
	"#"		prefix_bad	noeat recolor=-2

:byte Character
	*		char_end
	"\\"		maybe_byte_esc	recolor=-1
	"'\n\r\t"	bad_char	noeat recolormark

:maybe_byte_esc CharacterEscape
	*		bad_char	noeat recolormark
	"0nrt'\"\\"	char_end
	"x"		byte_hex1

:byte_hex1 CharacterEscape
	*		bad_char	noeat recolormark
	"0-9a-fA-F"	byte_hex2

:byte_hex2 CharacterEscape
	*		bad_char	noeat recolormark
	"0-9a-fA-F"	char_end


# Strings

:string String
	*		string
	"\\"		str_esc		mark recolor=-1
	"\""		suffix

:str_esc StringEscape
	*		str_bad_esc	noeat recolormark
	"0nrt'\"\n\\"	string
	"u"		maybe_str_uni
	"x"		str_hex1

:str_hex1 StringEscape
	*		str_bad_esc	noeat recolormark
	"0-7"		str_hex2

:str_hex2 StringEscape
	*		str_bad_esc	noeat recolormark
	"0-9a-fA-F"	string

:maybe_str_uni StringEscape
	*		str_bad_esc	noeat recolormark
	"{"		str_uni_start

:str_uni_start StringEscape
	*		str_bad_esc	noeat recolormark
	"0-9a-fA-F"	str_uni

:str_uni StringEscape
	*		str_bad_esc	noeat recolormark
	"0-9a-fA-F_"	str_uni
	"}"		string

:str_bad_esc Bad
	*		string


# Byte strings

:byte_str String
	*		byte_str
	"\\"		bstr_esc	mark recolor=-1
	"\""		suffix

:bstr_esc StringEscape
	*		bstr_bad_esc	noeat recolormark
	"0nrt'\"\n\\"	byte_str
	"x"		bstr_hex1

:bstr_hex1 StringEscape
	*		bstr_bad_esc	noeat recolormark
	"0-9a-fA-F"	bstr_hex2

:bstr_hex2 StringEscape
	*		bstr_bad_esc	noeat recolormark
	"0-9a-fA-F"	byte_str

:bstr_bad_esc Bad
	*		byte_str


# C strings

:cstr_prefix Idle
	*		idle		noeat
	"\""		c_string	recolor=-2
	"#'"		prefix_bad	noeat recolor=-2

:c_string String
	*		c_string
	"\\"		cstr_esc	mark recolor=-1
	"\""		suffix

:cstr_esc StringEscape
	*		cstr_bad_esc	noeat recolormark
	"nrt'\"\n\\"	c_string
	"u"		maybe_cstr_uni
	"x"		cstr_hex1

:cstr_hex1 StringEscape
	*		cstr_bad_esc	noeat recolormark
	"0"		cstr_hex2_0
	"1-7"		cstr_hex2

:cstr_hex2_0 StringEscape
	*		cstr_bad_esc	noeat recolormark
	"1-9a-fA-F"	c_string

:cstr_hex2 StringEscape
	*		cstr_bad_esc	noeat recolormark
	"0-9a-fA-F"	c_string

:maybe_cstr_uni StringEscape
	*		cstr_bad_esc	noeat recolormark
	"{"		cstr_uni_start

:cstr_uni_start StringEscape
	*		cstr_bad_esc	noeat recolormark
	"0"		cstr_uni_0
	"1-9a-fA-F"	cstr_uni

:cstr_uni_0 StringEscape
	*		cstr_bad_esc	noeat recolormark
	"0_"		cstr_uni_0
	"1-9a-fA-F"	cstr_uni

:cstr_uni StringEscape
	*		cstr_bad_esc	noeat recolormark
	"0-9a-fA-F_"	cstr_uni
	"}"		c_string

:cstr_bad_esc Bad
	*		c_string


# Raw strings

:raw_prefix Idle
	*		idle		noeat
	"#"		maybe_raw_ident	buffer
	"\""		raw_str0	recolormark recolor=-1
	"'"		raw_str_bad	noeat recolormark

:maybe_raw_ident Idle
	*		raw_ident	noeat
	"_"		maybe_raw_wild
	"#\""		raw_hash	noeat
	"0-9"		raw_str_bad	noeat recolormark

:maybe_raw_wild Idle
	*		raw_str_bad	noeat recolormark
	"0-9a-zA-Z_"	raw_ident

:raw_ident Idle
	*		idle		noeat
	"0-9a-zA-Z_"	raw_ident

:raw_str_prefix Idle
	*		idle		noeat
	"#"		raw_hash	recolormark recolor=-1 buffer
	"\""		raw_str0	recolormark recolor=-1
	"'"		raw_str_bad	noeat recolormark

:raw_hash String
	*		raw_str_bad	noeat recolormark
	"#"		raw_hash
	"\""		raw_start	hold recolormark

:raw_start String
	*		raw_str5_plus	noeat strings
	"#"		raw_str1
	"##"		raw_str2
	"###"		raw_str3
	"####"		raw_str4
done

:raw_str0 String
	*		raw_str0
	"\""		suffix

:raw_str1 String
	*		raw_str1
	"\""		maybe_raw_end1	buffer

:maybe_raw_end1 String
	*		raw_str1	noeat strings
	"\"#"		raw_end
done
	"#"		maybe_raw_end1	strings
	"\"#"		raw_end
done

:raw_str2 String
	*		raw_str2
	"\""		maybe_raw_end2	buffer

:maybe_raw_end2 String
	*		raw_str2	noeat strings
	"\"##"		raw_end
done
	"#"		maybe_raw_end2	strings
	"\"##"		raw_end
done

:raw_str3 String
	*		raw_str3
	"\""		maybe_raw_end3	buffer

:maybe_raw_end3 String
	*		raw_str3	noeat strings
	"\"###"		raw_end
done
	"#"		maybe_raw_end3	strings
	"\"###"		raw_end
done

:raw_str4 String
	*		raw_str4
	"\""		maybe_raw_end4	buffer

:maybe_raw_end4 String
	*		raw_str4	noeat strings
	"\"####"	raw_end
done
	"#"		maybe_raw_end4	strings
	"\"####"	raw_end
done

:raw_str5_plus String
	*		raw_str5_plus
	"\""		maybe_raw_end5	buffer

:maybe_raw_end5 String
	*		raw_str5_plus	noeat strings
	"\"#####"	raw_end5
done
	"#"		maybe_raw_end5	strings
	"\"#####"	raw_end5
done

:raw_end5 String
	*		raw_end		noeat
	"#"		raw_end5

:raw_end String
	*		suffix		noeat

:raw_str_bad Bad
	*		idle		noeat


# Identifiers (Edition 2024)

:ident Idle
	*		maybe_reserved	noeat strings

	# Strict keywords
	"as"		operator
	"async"		quali
	"await"		stmt
	"break"		loop
	"const"		quali
	"continue"	loop
	"crate"		kw
	"dyn"		kw
	"else"		cond
	"enum"		struct
	"extern"	quali
	"false"		bool
	"fn"		struct
	"for"		loop
	"if"		cond
	"impl"		kw
	"in"		operator
	"let"		kw
	"loop"		loop
	"match"		kw
	"mod"		kw
	"move"		kw
	"mut"		kw
	"pub"		quali
	"ref"		kw
	"return"	stmt
	"self"		kw
	"Self"		kw
	"static"	quali
	"struct"	struct
	"super"		kw
	"trait"		kw
	"true"		bool
	"type"		kw
	"unsafe"	quali
	"use"		kw
	"where"		kw
	"while"		loop

	# Weak keywords
	"macro_rules"	kw
	"raw"		kw
	"safe"		quali
	"union"		struct

	# Reserved keywords
	"abstract"	quali
	"become"	kw
	"box"		kw
	"do"		loop
	"final"		quali
	"gen"		kw
	"macro"		kw
	"override"	quali
	"priv"		quali
	"try"		kw
	"typeof"	kw
	"unsized"	quali
	"virtual"	quali
	"yield"		stmt

	# Built-in types
	"bool"		type
	"char"		type
	"f16"		type
	"f32"		type
	"f64"		type
	"f128"		type
	"i8"		type
	"i16"		type
	"i32"		type
	"i64"		type
	"i128"		type
	"isize"		type
	"str"		type
	"u8"		type
	"u16"		type
	"u32"		type
	"u64"		type
	"u128"		type
	"usize"		type

	# Deprecated (i.e. may be used as ident.)
	"alignof"	depr
	"be"		depr
	"int"		depr
	"offsetof"	depr
	"once"		depr
	"proc"		depr
	"pure"		depr
	"sizeof"	depr
	"uint"		depr

	# Special traits
	"Clone"		trait
	"Copy"		trait
	"Debug"		trait
	"Default"	trait
	"Display"	trait
	"Eq"		trait
	"Hash"		trait
	"Ord"		trait
	"PartialEq"	trait
	"PartialOrd"	trait
	"RefUnwindSafe"	trait
	"Send"		trait
	"Sync"		trait
	"Unpin"		trait
	"UnwindSafe"	trait
	"Drop"		trait
	"Error"		trait
	"Sized"		trait
	"Termination"	trait

	# Prefixes
	"b"		byte_prefix
	"c"		cstr_prefix
	"r"		raw_prefix
	"br"		raw_str_prefix
	"cr"		raw_str_prefix
done
	"a-zA-Z0-9_"	ident
	"!"		macro		noeat recolormark

:kw Keyword
	*		idle		noeat

:bool Boolean
	*		idle		noeat

:operator Operator
	*		idle		noeat

:stmt Statement
	*		idle		noeat

:cond Conditional
	*		idle		noeat

:loop Loop
	*		idle		noeat

:quali Qualifier
	*		idle		noeat

:struct Structure
	*		idle		noeat

:type Type
	*		idle		noeat

:trait SpecialTrait
	*		idle		noeat

:depr Deprecated
	*		idle		noeat

:maybe_reserved Idle
	*		idle		noeat recolormark
	"#'\""		prefix_bad	noeat recolormark

:prefix_bad Bad
	*		idle		noeat recolor=-1


# Macro invocations

:macro Macro
	*		idle


# Attributes

